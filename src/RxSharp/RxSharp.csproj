<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RxSharp</PackageId>
    <Title>RxSharp</Title>
    <Authors>Darío Kondratiuk</Authors>
    <Description>A .NET port of RxJS (Reactive Extensions for JavaScript).</Description>
    <PackageTags>rxjs;reactive;observable;rx;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hardkoded/rxjs-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hardkoded/rxjs-sharp</RepositoryUrl>
    <PackageVersion>0.1.0</PackageVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Deferred to the M4 docs/polish pass, not worth blocking TDD cycles on while the API is still moving:
        - CS1591, SA160x/SA161x: XML-doc completeness
        - CA1032, CA1063/CA1816: full "standard exception constructors" / IDisposable(bool)+finalizer ceremony
        - CA1062: defensive null-checks on every public parameter
        - CA1716: parameter names that happen to collide with keywords in other CLI languages (e.g. `error`)
    -->
    <NoWarn>$(NoWarn);CS1591;SA1600;SA1601;SA1602;SA1633;SA1618;SA1611;SA1615;SA1616;CA1032;CA1063;CA1816;CA1062;CA1716;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

</Project>
